# MovieBox Frontend Environment Configuration

# API Configuration - Points to Render backend
NEXT_PUBLIC_API_URL=https://movieb-rsoz.onrender.com/api/v1

# App Configuration
NEXT_PUBLIC_APP_NAME=MovieBox
NEXT_PUBLIC_APP_DESCRIPTION=Stream movies, TV shows, and anime from anywhere

# Optional: Analytics and Integrations
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_DEBUG_MODE=false

# Cloudflare Pages specific (if using Cloudflare for the frontend)
# These are set in wrangler.toml, not here
