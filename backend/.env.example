# StreamBox Streaming Platform - Environment Configuration

# ============================================
# Core Settings
# ============================================
APP_NAME=StreamBox
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ============================================
# Server Settings
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============================================
# Database
# ============================================
# SQLite (for development)
# DATABASE_URL=sqlite:///./database.db

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/streambox
# DATABASE_ECHO=false

# ============================================
# JWT & Security
# ============================================
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# ============================================
# reCAPTCHA
# ============================================
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_VERSION=v3

# ============================================
# Cloudflare Turnstile
# ============================================
ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# ============================================
# TMDB API
# ============================================
TMDB_API_KEY=your-tmdb-api-key

# ============================================
# Storage Provider
# ============================================
# Options: local, s3, r2, b2
STORAGE_PROVIDER=local

# ============================================
# AWS S3 (optional)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ============================================
# Cloudflare R2 (optional)
# ============================================
CF_ACCOUNT_ID=
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_BUCKET_NAME=

# ============================================
# Backblaze B2 (optional)
# ============================================
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=

# ============================================
# Email / SMTP
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@streambox.app

# ============================================
# Redis (optional)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Admin Credentials (change in production!)
# ============================================
ADMIN_EMAIL=admin@streambox.app
ADMIN_PASSWORD=admin123

# ============================================
# API Configuration
# ============================================
API_VERSION=v1
